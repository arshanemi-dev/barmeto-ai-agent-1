{
  "name": "barmeto-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop automation workspace",
  "author": "Barmeto",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "package": "npm run build && node scripts/package.mjs && electron-builder --win nsis",
    "package:dir": "npm run build && node scripts/package.mjs && electron-builder --dir",
    "browser:install": "playwright install chromium",
    "admin:dev": "next dev admin --webpack --port 3200 --hostname 127.0.0.1",
    "admin:build": "next build admin --webpack",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "cron-parser": "5.10.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "node-cron": "4.6.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3"
  },
  "build": {
    "appId": "com.barmeto.workspace",
    "productName": "Barmeto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".desktop",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
